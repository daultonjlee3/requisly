{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "remix",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && npm run build",
  "crons": [
    {
      "path": "/api/cron/ai-agents",
      "schedule": "0 13 * * *"
    }
  ]
}
