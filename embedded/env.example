# Copy to embedded/.env (gitignored). Shopify CLI also injects SHOPIFY_* when you run `npm run dev`.

# Supabase — same project as the root Next.js app (service role, server only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public Next.js origin for Supplier Link URLs (/s/:token) — not the embedded tunnel
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Optional override:
# SUPPLIER_LINK_BASE_URL=http://localhost:3001

# Usually filled by `shopify app dev` / config link:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=  # core scopes from shopify.app.toml (read_orders is optional_scopes)
# SHOPIFY_APP_URL=

# Billing: test charges in non-production by default (see billingIsTest()).
# SHOPIFY_BILLING_TEST=true
# Force-skip the subscription gate for local multi-store isolation QA only:
# SHOPIFY_SKIP_BILLING=true

# In-lane AI agents (Claude Haiku narrates insights; Resend emails the digest):
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Requisly <notifications@requisly.app>
# AI_DIGEST_FALLBACK_EMAIL=you@example.com
# CRON_SECRET=
