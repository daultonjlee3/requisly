# Copy to embedded/.env (gitignored). Shopify CLI also injects SHOPIFY_* when you run `npm run dev`.

# Supabase — same project as the root Next.js app (service role, server only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma session storage (Session table) — same Supabase Postgres as app data.
# Transaction pooler (6543) for runtime; Session pooler (5432 on pooler host) for migrate on Vercel
# (db.*.supabase.co:5432 is often unreachable from Vercel).
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public Next.js origin for Supplier Link URLs (/s/:token) — not the embedded tunnel
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Optional override:
# SUPPLIER_LINK_BASE_URL=http://localhost:3001

# Embedded Shopify app origin (production: https://app.requisly.com)
# EMBEDDED_APP_URL=https://app.requisly.com
# SHOPIFY_APP_URL=https://app.requisly.com

# Usually filled by `shopify app dev` / config link:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=  # core scopes from shopify.app.toml (read_orders is optional_scopes)
# SHOPIFY_APP_URL=

# Billing: test charges outside production only (billingIsTest() / billingSkipAllowed()
# both hard-refuse VERCEL_ENV=production — prod env vars are no-ops).
# Partner/development stores still get isTest charges on production Vercel.
# SHOPIFY_BILLING_TEST=true
# SHOPIFY_SKIP_BILLING=true

# In-lane AI agents (Claude Haiku narrates insights; Resend emails the digest):
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Requisly <notifications@requisly.app>
# Receiving subdomain for PO Reply-To (add MX in DNS — do not put Resend MX on apex):
# RESEND_INBOUND_DOMAIN=inbound.requisly.com
# AI_DIGEST_FALLBACK_EMAIL=you@example.com
# CRON_SECRET=
